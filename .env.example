# Database URL — Railway provides this automatically when you add a PostgreSQL service
DATABASE_URL=postgresql://user:password@host:5432/gnosis?schema=public

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-string

# Public URL — Railway provides this, but you need to set it after first deploy
# After deploy, go to Railway → Settings → Variables and set this to your Railway URL
NEXTAUTH_URL=https://your-app.up.railway.app

# LLM provider (optional — defaults to Z.ai free LLM)
# OPENAI_API_KEY=sk-your-openai-key

# Storage (optional — defaults to local /tmp)
# STORAGE_PROVIDER=local
